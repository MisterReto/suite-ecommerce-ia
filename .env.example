# Server only. Copy into Render Environment; never use NEXT_PUBLIC_* for secrets.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-frontend-service.onrender.com/auth/callback
GOOGLE_DRIVE_FOLDER_ID=
# Optional dedicated service account JSON in an environment variable, shared folder only.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Existing OAuth sessions still work; no silent scope revocation.
# Existing image/text model overrides are preserved; do not change for migration.
AI_PROVIDER=gemini
DATABASE_URL=
REDIS_URL=
GENERATION_QUEUE_BACKEND=rq
STUDIO_IMAGE_JOBS=worker
IMAGE_WORKER_CONCURRENCY=1
IMAGE_JOB_TIMEOUT_SECONDS=1800
GENERATION_REQUESTS_PER_MINUTE=12
MAX_IMAGES_PER_BATCH=30
# USD per confirmed batch, excludes variable research/QA cost. Optional.
MAX_ESTIMATED_BATCH_COST=
GOOGLE_SHEET_ID=
# Generate once with cryptography.fernet.Fernet.generate_key(); same key on web + worker.
CREDENTIAL_ENCRYPTION_KEY=
# Individual roles; APP_ALLOWED_EMAILS may also authorize catalog members.
# Roles: admin, editor, viewer. Unmapped allowed users use APP_DEFAULT_ROLE.
APP_ROLE_MAP={"tu-correo@example.com":"admin"}
APP_DEFAULT_ROLE=viewer
AI_ESTIMATED_IMAGE_USD=0.067
# API and worker share PostgreSQL, Redis and the same credential encryption key.

# Frontend and API are separate services.
# Frontend build only (public API origin; never append an API key):
SUITE_FRONTEND_MODE=standalone
SUITE_API_ORIGIN=https://your-api-service.onrender.com
# API only: browser-facing UI origin for request validation, not a wildcard.
APP_PUBLIC_ORIGIN=https://your-frontend-service.onrender.com
SUITE_SERVE_FRONTEND=false
APP_ALLOWED_EMAILS=
APP_REQUIRE_ALLOWLIST=true
# API and worker use the same access policy. Separate allowed emails with commas,
# semicolons or line breaks, or use a JSON array. Without an explicit allowlist,
# APP_REQUIRE_ALLOWLIST=true only permits valid entries from APP_ROLE_MAP.

# Accepted Colab uploader. These values stay server-side on API and worker.
WOOCOMMERCE_URL=https://rincon.creandotusite.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WP_USERNAME=
WP_APP_PASSWORD=
# Optional source overrides; defaults match the accepted Colab notebook.
WOOCOMMERCE_SHEET_ID=1gnuDwcceWwN4ksNnyq3Hs_MQHTfnZQZjeLnph72aUrE
WOOCOMMERCE_IMAGES_FOLDER_ID=1V4HgnTCRnwVGwrGD968eNdtvQDGGY7wt
WOOCOMMERCE_MAX_BATCH_PRODUCTS=1000
