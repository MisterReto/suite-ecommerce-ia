FROM node:22-alpine AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# API origin is public configuration, never a credential.
ARG SUITE_API_ORIGIN
ENV SUITE_FRONTEND_MODE=standalone NEXT_TELEMETRY_DISABLED=1
RUN SUITE_API_ORIGIN="$SUITE_API_ORIGIN" npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=7860
COPY --from=build --chown=node:node /build/.next/standalone/ ./
COPY --from=build --chown=node:node /build/.next/static/ ./.next/static/
COPY --from=build --chown=node:node /build/public/ ./public/
USER node
EXPOSE 7860
CMD ["node", "server.js"]
